{
  "version": 1,
  "id": "logs",
  "states": {
    "contents": { "type": "string", "initial": "Carregando..." }
  },
  "view": {
    "type": "Column",
    "props": { "padding": 20, "spacing": 12, "fillWidth": true, "fillHeight": true },
    "children": [
      { "type": "Text", "props": { "text": "Logs da aplicação" }, "style": { "fontSize": 18, "bold": true } },
      { "type": "Row", "props": { "spacing": 10 }, "children": [
        { "type": "Button", "props": { "text": "Atualizar" }, "events": { "onClick": "refresh" } },
        { "type": "Button", "props": { "text": "Abrir pasta de logs" }, "events": { "onClick": "openFolder" } }
      ] },
      { "type": "TextArea", "id": "logContents", "props": { "height": 500, "readOnly": true },
        "style": { "fontFamily": "Courier New", "fontSize": 12 }, "bind": { "value": "contents" } }
    ]
  }
}
